<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <delete model="ir.rule" id="hr_loan_rule_user"/>

        <record id="module_category_hr_loan" model="ir.module.category">
            <field name="name">Loans &amp; Advances</field>
            <field name="parent_id" ref="base.module_category_human_resources"/>
            <field name="sequence">50</field>
        </record>

        <record id="group_hr_loan_manager" model="res.groups">
            <field name="name">Loan Manager</field>
            <field name="category_id" ref="module_category_hr_loan"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Multi-company rule on the 'hr_loan' model -->
        <record id="hr_loan_rule_company" model="ir.rule">
            <field name="name">Loan Request Multi Company</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field eval="True" name="global"/>
            <field name="domain_force">
                ['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]
            </field>
        </record>

        <!-- Loan managers can access all loan requests -->
        <record id="hr_loan_rule_manager" model="ir.rule">
            <field name="name">Loan Manager: all loan requests</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_loan_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Employees can only access their own loan requests -->
        <record id="hr_loan_rule_employee" model="ir.rule">
            <field name="name">User: own loan requests only</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Loan managers can access all loan installment lines -->
        <record id="hr_loan_line_rule_manager" model="ir.rule">
            <field name="name">Loan Manager: all loan installment lines</field>
            <field name="model_id" ref="model_hr_loan_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_loan_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Employees can only access their own loan installment lines -->
        <record id="hr_loan_line_rule_employee" model="ir.rule">
            <field name="name">User: own loan installment lines only</field>
            <field name="model_id" ref="model_hr_loan_line"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
