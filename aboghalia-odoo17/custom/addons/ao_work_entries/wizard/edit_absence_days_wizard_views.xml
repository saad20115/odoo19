<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edit_absence_days_wizard_form" model="ir.ui.view">
        <field name="name">edit.absence.days.wizard.form</field>
        <field name="model">edit.absence.days.wizard</field>
        <field name="arch" type="xml">
            <form string="Edit Employees' Absence Days">
                <sheet>
                    <group>
                        <field name="year" invisible="1"/>
                        <field name="month" invisible="1"/>
                        <field name="department_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="employee_ids"
                               widget="many2many_tags"
                               domain="[('department_id', 'in', department_ids)]"
                               options="{'no_create': True}"/>
                        <field name="absence_days"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_edit_absence_days_wizard" model="ir.actions.act_window">
        <field name="name">Edit Employees' Absence Days</field>
        <field name="res_model">edit.absence.days.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
