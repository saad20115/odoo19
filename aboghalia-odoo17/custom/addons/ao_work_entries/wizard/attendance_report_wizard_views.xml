<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">attendance.report.wizard.form</field>
        <field name="model">attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Attendance Summary Report" class="ao_attendance_report_wizard_form">
                <sheet>
                    <group>
                        <field name="print_all"/>
                        <field name="department_ids" widget="many2many_tags"
                                 invisible="print_all" required="not print_all"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Attendance Summary Report</field>
        <field name="res_model">attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
