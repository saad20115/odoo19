<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_employee_request_tree" model="ir.ui.view">
        <field name="name">employee.request.tree</field>
        <field name="model">employee.request</field>
        <field name="arch" type="xml">
            <tree string="Transactions Requests" multi_edit="1">
                <field name="serial_number" optional="show"/>
                <field name="request_mode" widget="badge" decoration-info="request_mode == 'incoming'" decoration-primary="request_mode == 'outgoing'" optional="show"/>
                <field name="request_scope" widget="badge" decoration-success="request_scope == 'internal'" decoration-warning="request_scope == 'external'" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="department" optional="show"/>
                <field name="request_topic" optional="show"/>
                <field name="incoming_number" optional="show"/>
                <field name="created_by" optional="show"/>
                <field name="employee_ids" widget="many2many_tags" optional="show"/>
                <field name="transaction_type" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="status" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_employee_request_form" model="ir.ui.view">
        <field name="name">employee.request.form</field>
        <field name="model">employee.request</field>
        <field name="arch" type="xml">
            <form string="Transactions Request" archivable="true">
                <header>
                    <button name="action_start" type="object" string="بدء" class="oe_highlight btn-primary" invisible="status != 'new'"/>
                    <button name="action_in_progress" type="object" string="قيد الاجراء" class="btn-secondary" invisible="status != 'new'"/>
                    <button name="action_overdue" type="object" string="متأخر" class="btn-danger" invisible="status != 'in_progress'"/>
                    <button name="action_done" type="object" string="منتهى" class="btn-success" invisible="status not in ('in_progress', 'overdue')"/>
                    <field name="status" widget="statusbar" statusbar_visible="new,in_progress,overdue,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_whatsapp"
                                type="object"
                                string="واتساب"
                                icon="fa-whatsapp"
                                class="btn btn-success"
                                invisible="partner_phone == False" />
                    </div>

                    <group name="mode_scope_header" cols="4">
                        <group>
                            <field name="request_mode" required="1"/>
                        </group>
                        <group>
                            <field name="request_scope" required="1"/>
                        </group>
                        <group>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="confidentiality"/>
                        </group>
                    </group>

                    <group cols="2">
                        <group string="معلومات المعاملة">
                            <field name="serial_number"/>
                            <field name="company_id" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" can_create="false"/>
                            <field name="partner_id" invisible="request_scope == 'internal'" required="request_scope == 'external'" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" can_create="false"/>
                            <field name="partner_phone" invisible="request_scope == 'internal'"/>
                            <field name="contact_email" invisible="request_scope == 'internal'"/>
                            <field name="department" invisible="1" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" can_create="false"/>
                            <field name="incoming_number" invisible="request_mode == 'outgoing'"/>
                            <field name="parent_transaction_id" invisible="request_mode == 'incoming'" options="{'no_create': True, 'no_open': True}"/>
                            <field name="created_by" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True, 'no_open': True}" can_create="false"/>
                            <field name="employee_ids" invisible="1" widget="many2many_tags" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" can_create="false"/>
                            <field name="transaction_type" options="{'no_create': True, 'no_quick_create': True, 'no_create_edit': True}" can_create="false"/>
                            <field name="project_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="financial_value"/>
                        </group>
                        <group string="التواريخ وتفاصيل التتبع">
                            <field name="qr_code" widget="image" class="oe_avatar"/>
                            <field name="request_topic"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="الوصف والتفاصيل" name="description_page">
                            <field name="description" widget="html" nolabel="1"/>
                        </page>
                        <page string="التوجيهات والمهام الداخلية" name="subtasks_page">
                            <field name="subtask_ids">
                                <tree editable="bottom" string="المهام الفرعية">
                                    <field name="department_id" options="{'no_create': True}"/>
                                    <field name="employee_id" options="{'no_create': True}" domain="[('department_id', '=', department_id)]"/>
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                </tree>
                                <form string="تفاصيل المهمة الفرعية">
                                    <header>
                                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                                    </header>
                                    <sheet>
                                        <div class="oe_title">
                                            <h1><field name="name" placeholder="المهمة المطلوبة..."/></h1>
                                        </div>
                                        <group>
                                            <group string="التعيين">
                                                <field name="department_id"/>
                                                <field name="employee_id" domain="[('department_id', '=', department_id)]"/>
                                                <field name="due_date"/>
                                            </group>
                                            <group string="ملخص المعاملة">
                                                <field name="request_serial"/>
                                                <field name="request_topic"/>
                                            </group>
                                        </group>
                                        <notebook>
                                            <page string="ملاحظات والتفاصيل">
                                                <field name="notes" widget="html"/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                    <div class="oe_chatter">
                                        <field name="message_follower_ids"/>
                                        <field name="activity_ids"/>
                                        <field name="message_ids"/>
                                    </div>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_employee_request_search" model="ir.ui.view">
        <field name="name">employee.request.search</field>
        <field name="model">employee.request</field>
        <field name="arch" type="xml">
            <search string="بحث وتصفية الاتصالات الإدارية">
                <!-- Searchable Fields -->
                <field name="serial_number" string="رقم المعاملة / السيريال"/>
                <field name="incoming_number" string="رقم الوارد الخارجي"/>
                <field name="request_topic" string="موضوع المعاملة / الجهة"/>
                <field name="partner_id" string="اسم العميل / الجهة"/>
                <field name="partner_phone" string="رقم الهاتف"/>
                <field name="company_id" string="الشركة"/>
                <field name="department" string="القسم الإداري"/>
                <field name="employee_ids" string="الموظف المسؤول"/>
                <field name="created_by" string="أنشئ بواسطة"/>
                <field name="transaction_type" string="نوع المعاملة"/>
                <field name="tag_ids" string="التوسيمات (Tags)"/>
                <field name="request_mode" string="اتجاه المعاملة (وارد/صادر)"/>
                <field name="request_scope" string="نطاق المعاملة (داخلي/خارجي)"/>
                <field name="status" string="الحالة"/>
                <field name="start_date" string="تاريخ البداية"/>
                <field name="end_date" string="تاريخ النهاية"/>

                <!-- Quick Filters -->
                <separator/>
                <filter name="filter_incoming" string="📥 معاملات واردة" domain="[('request_mode','=','incoming')]"/>
                <filter name="filter_outgoing" string="📤 معاملات صادرة" domain="[('request_mode','=','outgoing')]"/>
                <separator/>
                <filter name="filter_internal" string="🏢 معاملات داخلية" domain="[('request_scope','=','internal')]"/>
                <filter name="filter_external" string="🌍 معاملات خارجية" domain="[('request_scope','=','external')]"/>
                <separator/>
                <filter name="filter_new" string="🟢 جديد" domain="[('status','=','new')]"/>
                <filter name="filter_in_progress" string="🟡 قيد الإجراء" domain="[('status','=','in_progress')]"/>
                <filter name="filter_overdue" string="🔴 متأخر" domain="[('status','=','overdue')]"/>
                <filter name="filter_done" string="🔵 منتهى" domain="[('status','=','done')]"/>
                <separator/>
                <filter name="filter_active" string="النشطة" domain="[('active','=',True)]"/>
                <filter name="filter_archived" string="📦 المؤرشفة" domain="[('active','=',False)]"/>

                <!-- Group By Filters -->
                <group expand="1" string="تجميع حسب (Group By)">
                    <filter name="group_by_mode" string="اتجاه المعاملة (وارد/صادر)" context="{'group_by':'request_mode'}"/>
                    <filter name="group_by_scope" string="نطاق المعاملة (داخلي/خارجي)" context="{'group_by':'request_scope'}"/>
                    <filter name="group_by_status" string="حالة المعاملة" context="{'group_by':'status'}"/>
                    <filter name="group_by_company" string="الشركة" context="{'group_by':'company_id'}"/>
                    <filter name="group_by_department" string="القسم الإداري" context="{'group_by':'department'}"/>
                    <filter name="group_by_partner" string="العميل / الجهة" context="{'group_by':'partner_id'}"/>
                    <filter name="group_by_transaction_type" string="نوع المعاملة" context="{'group_by':'transaction_type'}"/>
                    <filter name="group_by_created_by" string="أنشئ بواسطة" context="{'group_by':'created_by'}"/>
                    <filter name="group_by_employee" string="الموظف المسؤول" context="{'group_by':'employee_ids'}"/>
                    <filter name="group_by_tags" string="التوسيمات (Tags)" context="{'group_by':'tag_ids'}"/>
                    <filter name="group_by_start_date" string="تاريخ البداية (حسب الشهر)" context="{'group_by':'start_date:month'}"/>
                    <filter name="group_by_end_date" string="تاريخ النهاية (حسب الشهر)" context="{'group_by':'end_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_employee_request_analysis_pivot_main_clean" model="ir.ui.view">
        <field name="name">employee.request.analysis.pivot.main.clean</field>
        <field name="model">employee.request.analysis</field>
        <field name="arch" type="xml">
            <pivot string="التحليل الرئيسي">
                <field name="status" type="row"/>
                <field name="transaction_type_name" type="row"/>
                <field name="company_name" type="col"/>
                <field name="duration_days" type="measure" string="متوسط المدة"/>
                <field name="days_overdue" type="measure" string="متوسط التأخير"/>
            </pivot>
        </field>
    </record>

    <record id="view_employee_request_pivot_main" model="ir.ui.view">
        <field name="name">employee.request.pivot.main</field>
        <field name="model">employee.request</field>
        <field name="arch" type="xml">
            <pivot string="تحليل المعاملات">
                <field name="status" type="row"/>
                <field name="transaction_type" type="row"/>
                <field name="company_id" type="col"/>
            </pivot>
        </field>
    </record>
    <!--    Graph View-->

    <record id="view_employee_request_graph" model="ir.ui.view">
    <field name="name">employee.request.graph</field>
    <field name="model">employee.request</field>
    <field name="arch" type="xml">
        <graph string="تحليل بياني">
            <field name="transaction_type" type="row"/>
            <field name="status" type="col"/>
            <field name="id" type="measure"/>
        </graph>
    </field>
</record>
<!--    Calendar View-->
<record id="view_employee_request_calendar" model="ir.ui.view">
    <field name="name">employee.request.calendar</field>
    <field name="model">employee.request</field>
    <field name="arch" type="xml">
        <calendar string="جدول المواعيد"
                  date_start="start_date"
                  date_stop="end_date"
                  color="employee_ids">
            <field name="serial_number"/>
        </calendar>
    </field>
</record>

    <!-- Kanban View -->
    <record id="view_employee_request_kanban" model="ir.ui.view">
        <field name="name">employee.request.kanban</field>
        <field name="model">employee.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="serial_number"/>
                <field name="partner_id"/>
                <field name="request_topic"/>
                <field name="status"/>
                <field name="company_id"/>
                <field name="department"/>
                <field name="transaction_type"/>
                <field name="employee_ids"/>
                <field name="tag_ids"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-3 mb-2 rounded-3 shadow-sm border-top border-4 #{record.status.raw_value == 'done' ? 'border-success' : (record.status.raw_value == 'overdue' ? 'border-danger' : (record.status.raw_value == 'in_progress' ? 'border-info' : 'border-primary'))}">
                            <div class="oe_kanban_details d-flex flex-column justify-content-between h-100">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="o_kanban_record_title text-primary fs-6 fw-bold">
                                                <i class="fa fa-hashtag me-1"></i><field name="serial_number"/>
                                            </strong>
                                            <span t-attf-class="badge rounded-pill #{record.status.raw_value == 'done' ? 'bg-success' : (record.status.raw_value == 'overdue' ? 'bg-danger' : (record.status.raw_value == 'in_progress' ? 'bg-info text-dark' : 'bg-primary'))}">
                                                <field name="status"/>
                                            </span>
                                        </div>
                                        <div class="text-muted small fw-semibold">
                                            <i class="fa fa-building-o me-1"></i><field name="company_id"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body mb-2">
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 250px;" t-att-title="record.request_topic.raw_value">
                                        <field name="request_topic"/>
                                    </div>
                                    <div t-if="record.partner_id.raw_value" class="text-secondary small mt-1">
                                        <i class="fa fa-user-circle me-1"></i><field name="partner_id"/>
                                    </div>
                                    <div t-if="record.transaction_type.raw_value" class="badge bg-light text-dark border mt-1">
                                        <field name="transaction_type"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom d-flex justify-content-between align-items-center pt-2 border-top">
                                    <div class="oe_kanban_bottom_left text-muted small">
                                        <i class="fa fa-calendar me-1"></i><field name="end_date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="employee_ids" widget="many2many_tags"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_employee_request" model="ir.actions.act_window">
        <field name="name">Employee Requests</field>
        <field name="res_model">employee.request</field>
        <field name="view_mode">tree,kanban,form,pivot,graph,calendar</field>
        <field name="search_view_id" ref="view_employee_request_search"/>
        <field name="help" type="html">
            <p>Create and track employee requests here.</p>
        </field>
    </record>

     <!-- Menu Item -->
   <menuitem id="menu_employee_request"
             name="الاتصالات الإدارية"
             action="action_employee_request"
             sequence="1"/>



</odoo>
