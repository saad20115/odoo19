<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_tree_sjc" model="ir.ui.view">
        <field name="name">hr.expense.tree.sjc</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_expenses_analysis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="sjc_due_date" optional="show"/>
                <field name="sjc_sent_to_manager_by_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
