                                <div class="sjc-sidebar-title" t-esc="label('employees_sidebar')"/>
                                <input type="search" class="sjc-sidebar-search"
                                       t-att-placeholder="label('search_people')"
                                       t-att-value="state.peopleSearch"
                                       t-on-input="onPeopleSearch"/>
                            </div>
                            <div class="sjc-sidebar-body">
                                <div class="sjc-sidebar-group">
                                    <div class="sjc-sidebar-group-title" t-esc="label('created_by_users')"/>
                                    <t t-foreach="filterPeople(state.data.creators)" t-as="person" t-key="'ecr-' + person.id">
                                        <div class="sjc-person-row">
                                            <img class="sjc-avatar" t-att-src="person.avatar" alt=""/>
                                            <div class="sjc-person-info">
                                                <div class="sjc-person-name" t-esc="person.name"/>
                                            </div>
                                            <span class="sjc-person-count" t-esc="person.count || 0"/>
                                        </div>
                                    </t>
                                    <t t-if="!filterPeople(state.data.creators).length">
                                        <div class="sjc-sidebar-empty" t-esc="label('empty')"/>
                                    </t>
                                </div>
                                <div class="sjc-sidebar-group">
                                    <div class="sjc-sidebar-group-title" t-esc="label('sent_to_manager')"/>
                                    <t t-foreach="filterPeople(state.data.senders)" t-as="person" t-key="'es-' + person.id">
                                        <div class="sjc-person-row">
                                            <img class="sjc-avatar" t-att-src="person.avatar" alt=""/>
                                            <div class="sjc-person-info">
                                                <div class="sjc-person-name" t-esc="person.name"/>
                                            </div>
                                            <span class="sjc-person-count" t-esc="person.count || 0"/>
                                        </div>
                                    </t>
                                    <t t-if="!filterPeople(state.data.senders).length">
                                        <div class="sjc-sidebar-empty" t-esc="label('empty')"/>
                                    </t>
                                </div>
                                <div class="sjc-sidebar-group">
                                    <div class="sjc-sidebar-group-title" t-esc="label('managers')"/>
                                    <t t-foreach="filterPeople(state.data.managers)" t-as="person" t-key="'em-' + person.id">
                                        <div class="sjc-person-row">
                                            <img class="sjc-avatar" t-att-src="person.avatar" alt=""/>
                                            <div class="sjc-person-info">
                                                <div class="sjc-person-name" t-esc="person.name"/>
                                            </div>
                                            <span class="sjc-person-count" t-esc="person.count || 0"/>
                                        </div>
                                    </t>
                                    <t t-if="!filterPeople(state.data.managers).length">
                                        <div class="sjc-sidebar-empty" t-esc="label('empty')"/>
                                    </t>
                                </div>
                            </div>
                        </aside>
                    </div>
                </t>

                <!-- ================= EMAILS ================= -->
                <t t-elif="page === 'emails'">
                    <div class="sjc-hero">
                        <div>
                            <h2 t-esc="state.data.title"/>
                            <p><t t-esc="label('total')"/>: <t t-esc="state.data.total_mails"/></p>
                        </div>
                        <div class="sjc-hero-actions" t-if="state.data.can_interact_mail">
                            <button type="button" class="btn btn-primary sjc-btn-inbox" t-on-click="() => this.openIncomingMail()">
                                <i class="fa fa-envelope-o"/> <t t-esc="label('open_inbox')"/>
                            </button>
                        </div>
                    </div>

                    <t t-if="showOverviewPanels">
                        <div class="sjc-section-title" t-esc="label('mailboxes')"/>
                        <div class="sjc-mailbox-grid">
                            <t t-foreach="state.data.mailboxes" t-as="box" t-key="box.name">
                                <div class="sjc-mailbox-card">
                                    <div class="sjc-mailbox-name" t-esc="box.name"/>
                                    <div class="sjc-mailbox-count" t-esc="box.count"/>
                                </div>
                            </t>
                            <t t-if="!state.data.mailboxes.length">
                                <div class="sjc-empty" t-esc="label('empty')"/>
                            </t>
                        </div>
                    </t>

                    <div t-att-class="showPeopleSidebar ? 'sjc-page-split' : 'sjc-page-solo'">
                        <div class="sjc-page-main">
                            <div class="sjc-card">
                                <div class="sjc-ch" t-esc="label('recent')"/>
                                <div class="sjc-cb">
                                    <t t-foreach="state.data.recent" t-as="mail" t-key="mail.id">
                                        <div class="sjc-task-card sjc-task-card-row" t-on-click="() => this.openTaskDetail(mail)">
                                            <div class="sjc-task-card-main">
                                                <div class="sjc-task-card-title" t-esc="mail.name"/>
                                                <div class="sjc-task-card-sub">
                                                    <span t-esc="mail.mailbox || mail.email_from"/>
                                                </div>
                                                <div class="sjc-task-card-hint" t-esc="label('click_for_details')"/>
                                            </div>
                                            <div class="sjc-task-card-side">
                                                <button type="button" class="sjc-goto-btn"
                                                        t-att-title="label('go_to_record')"
                                                        t-on-click.stop="(ev) => this.goToRecord(mail, ev)">
                                                    <i class="fa fa-external-link"/>
                                                </button>
                                                <span class="sjc-badge st-new" t-if="mail.state === 'new'" t-esc="mail.status_label"/>
                                                <span class="sjc-badge st-completed" t-elif="mail.state === 'done' || mail.state === 'archived'" t-esc="mail.status_label"/>
                                                <span class="sjc-badge st-in_progress" t-else="" t-esc="mail.status_label"/>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-if="!state.data.recent.length">
                                        <div class="sjc-empty" t-esc="label('empty')"/>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <aside t-if="showPeopleSidebar" class="sjc-people-sidebar">
                            <div class="sjc-sidebar-head">
                                <div class="sjc-sidebar-title" t-esc="label('employees_sidebar')"/>
                                <input type="search" class="sjc-sidebar-search"
                                       t-att-placeholder="label('search_people')"
                                       t-att-value="state.peopleSearch"
                                       t-on-input="onPeopleSearch"/>
                            </div>
                            <div class="sjc-sidebar-body">
                                <div class="sjc-sidebar-group">
                                    <div class="sjc-sidebar-group-title" t-esc="label('inbox_staff')"/>
                                    <t t-foreach="filterPeople(state.data.inbox_staff)" t-as="staff" t-key="'is-' + staff.id">
                                        <div class="sjc-person-row">
                                            <img class="sjc-avatar" t-att-src="staff.avatar" alt=""/>
                                            <div class="sjc-person-info">
                                                <div class="sjc-person-name" t-esc="staff.name"/>
                                                <div class="sjc-person-meta" t-esc="label('assigned_out')"/>
                                            </div>
                                            <span class="sjc-person-count" t-esc="staff.assigned_count || 0"/>
                                        </div>
                                    </t>
                                    <t t-if="!filterPeople(state.data.inbox_staff).length">
                                        <div class="sjc-sidebar-empty" t-esc="label('empty')"/>
                                    </t>
                                </div>
                                <div class="sjc-sidebar-group">
                                    <div class="sjc-sidebar-group-title" t-esc="label('assignees')"/>
                                    <t t-foreach="filterPeople(state.data.assignees)" t-as="person" t-key="'ea-' + person.id">
                                        <div class="sjc-person-row">
                                            <img class="sjc-avatar" t-att-src="person.avatar" alt=""/>
                                            <div class="sjc-person-info">
                                                <div class="sjc-person-name" t-esc="person.name"/>
                                                <div class="sjc-person-meta" t-if="person.assigned_by">
                                                    <t t-esc="label('assigned_by')"/>: <t t-esc="person.assigned_by.name"/>
                                                </div>
                                            </div>
                                            <span class="sjc-person-count" t-esc="person.email_count || 0"/>
                                        </div>
                                    </t>
                                    <t t-if="!filterPeople(state.data.assignees).length">
                                        <div class="sjc-sidebar-empty" t-esc="label('empty')"/>
                                    </t>
                                </div>
                            </div>
                        </aside>
                    </div>
                </t>
            </div>

            <t t-if="state.selectedTask">
                <div class="sjc-modal-backdrop" t-on-click="onDetailBackdrop">
                    <div class="sjc-modal" t-on-click.stop="() => {}">
                        <div class="sjc-modal-head">
                            <div>
                                <div class="sjc-modal-kicker" t-esc="label('details')"/>
                                <h3 class="sjc-modal-title" t-esc="state.selectedTask.name"/>
                            </div>
                            <button type="button" class="sjc-modal-x" t-on-click="() => this.closeTaskDetail()">×</button>
                        </div>
                        <div class="sjc-modal-status">
                            <span class="sjc-badge" t-att-class="'st-' + taskStatus(state.selectedTask)" t-esc="state.selectedTask.status_label"/>
                        </div>
                        <div class="sjc-modal-body">
                            <t t-foreach="detailRows(state.selectedTask)" t-as="row" t-key="row.key">
                                <div class="sjc-modal-row">
                                    <div class="sjc-modal-label" t-esc="row.label"/>
                                    <div class="sjc-modal-value" t-esc="row.value"/>
                                </div>
                            </t>
                        </div>
                        <div class="sjc-modal-actions">
                            <button type="button" class="btn btn-secondary" t-on-click="() => this.closeTaskDetail()" t-esc="label('close')"/>
                            <button type="button" class="btn btn-primary" t-on-click="() => this.goToRecord(state.selectedTask)" t-esc="label('go_to_record')"/>
                            <button type="button" class="btn btn-primary sjc-btn-instruct"
                                    t-if="canSendInstructions(state.selectedTask)"
                                    t-on-click="() => this.openInstructionWizard(state.selectedTask)"
                                    t-esc="label('send_instructions')"/>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
