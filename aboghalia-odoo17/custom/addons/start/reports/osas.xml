<odoo>
    <data>

        <record id="new_report_invoice_order" model="ir.actions.report" >
            <field name="name">  Report</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">start.report_invoice_order_template</field>
            <field name="report_file">start.report_invoice_order_template</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name= "print_report_name">object.name.split('/')[-1]</field>
         </record>
  
      <template id="report_invoice_order_custom_header">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
          <!--   Multicompany   -->
          <t t-if="company_id">
            <t t-set="company" t-value="company_id"/>
          </t>
          <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
            <t t-set="company" t-value="o.company_id.sudo()"/>
          </t>
          <t t-else="else">
            <t t-set="company" t-value="res_company"/>
          </t>
        </t>
        <div class="header mb4" t-att-style="report_header_style">
         
            
          

        </div>
        <div class="article o_report_layout_standard">
          <t t-out="0"/>
        </div>
        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">

          
        </div>
      </template>
      <template id="report_invoice_order_template">
        <t t-call="web.html_container">
          <t t-foreach="docs" t-as="docs">
            <t t-call="start.report_invoice_order_custom_header">
              <div class="page">
                <head>
                  <!--   add this style to define the page size and margins   -->
                  <style>@page { size: A4 portrait; margin: 1cm; }</style>
                </head>
                <style>table { border-collapse: collapse; table-layout: fixed; /* add this line */ } th, td
                  { border: 1px solid black; padding: 5px; text-align: center; word-wrap: break-word; /*
                  add this line */ }
                </style>
                <body style="font-family: 'Times New Roman', Times, serif;">
                  <div style="direction: ltr">
                      <h2 align="right">
  
                          <span t-if="docs.move_type == 'out_invoice' and docs.state == 'posted'">
                              <t t-if="docs.partner_id.vat">
                                  <!-- If the customer has a tax number -->
                                  <div>فاتورة ضريبة</div>
                              </t>
                              <t t-else="">
                                  <!-- If the customer does not have a tax number -->
                                  <div>فاتورة ضريبة مبسطة</div>
                              </t>
                          </span>
                          <span t-if="docs.move_type == 'out_invoice' and docs.state == 'draft'">مسودة فاتورة</span>
                          <span t-if="docs.move_type == 'out_invoice' and docs.state == 'cancel'">فاتورة ملغاه</span>
                          <span t-if="docs.move_type == 'out_refund'">أشعار دائن</span>
                          <span t-if="docs.move_type == 'in_refund'">أشعار مدين</span> 
  
                          <span t-if="docs.move_type == 'in_invoice'"> فاتورة المورد</span>
                          <!-- <span t-if="docs.name != '/'" t-field="docs.name"/> -->
                        </h2>
                      
                      <div >
                          
                                <img t-if="docs.l10n_sa_qr_code_str" style="margin-left: 55px;float: left; margin-top:2% " t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', quote_plus(docs.l10n_sa_qr_code_str), 160, 160)"/>
          
                          
                      <!-- <h2 >Additional Details</h2> -->
                      <table class="table"  style=" font-size:20px;float: right;width: 60%; border: 2px solid #000; margin-top:2%">
                          <!-- <thead>
                              <th align="center" colspan="3" style="background-color: #deeaf6;">Vendor Details
                                  - بيانات المورد
                              </th>
                          </thead> -->
                          <tbody >
                              <tr style="border: 2px solid #000;">
                                  <tr style="border: 2px solid #000;">
                                  <td align="right"><t t-esc="docs.invoice_date"/></td>
                                  <th>: تاريخ إصدار الفاتورة </th>
                              </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.company_id.vat"/></td>
                                      <th>:الرقم الضريبي للمنشأة </th>
                                  </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.name.split('/')[-1]"/></td>
                                      <th>:رقم الفاتورة </th>
                                  </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.company_id.name"/></td>
                                      <th>:اسم الاستشاري</th>
                                  </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.company_id.street"/></td>
                                      <th>:العنوان</th>
                                  </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.company_id.city"/></td>
                                      <th>: السجل التجاري</th>
                                  </tr>
                                  
                                  <tr style="border: 2px solid #000;">
                                      <td><t t-esc="docs.ref"/></td>
                                      <th>البيان </th>
                                  </tr>
                              </tr>
  
                              <!-- Add more rows as needed -->
                          </tbody>
                      </table>
                  </div>
                      <table class="table" style=" font-size:20px; width: 95%; border: 2px solid #000; float: right">
                          <!-- <thead>
                              <th align="center" colspan="3" style="background-color: #deeaf6;">Customer Details
                                  - بيانات العميل -
                                </th>
                          </thead> -->
                          <tbody>
                              <tr>
                                  <tr style="border: 2px solid #000;">
                                  <td align="right"><t t-esc="docs.partner_id.name"/></td>
                                  <th >:اسم الشركة</th>
                              </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.partner_id.street"/></td>
                                      <th>:العنوان</th>
                                  </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.partner_id.vat"/></td>
                                      <th>:الرقم الضريبي</th>
                                  </tr>
                                  <!-- <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.company_id.id"/></td>
                                      <th>:مرجع الشركة</th>
                                  </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.partner_id.street2"/></td>
                                      <th>:رقم العقد</th>
                                  </tr>
                                  <tr style="border: 2px solid #000;">
                                      <td align="right"><t t-esc="docs.partner_id.city"/></td>
                                      <th>:رقم المستخلص </th>
                                  </tr> -->
                                  
                                  <!-- <td>Data 1-2</td>
                                      <td>Data 1-3</td> -->
                                  </tr>
                              </tbody>
                          </table>
  
                          
                          <!-- <h1>Sale Quotation</h1>
                              <p>Quotation Number: <span t-field="docs.name"/></p> -->
                              
                              <table class="table" style=" font-size:15px;float: left;width: 100%; border: 2px solid #000;">
                                  <thead>
                                      
                                      <tr style="background-color:rgb(160, 255, 143)">
                                  <th>القيمة شامل الضريبة</th>
                                  <th>مبلغ الضريبة</th>
                                  <th> الضريبة %</th>
                                  <th>الاجمالي قبل الضريبة</th>
                                  <th>الخصم</th>
                                  <th>الكمية</th>
                                  <th>سعر الوحدة</th>
                                  <th> البيان</th>
                                  <th>م</th>
                              </tr>
                          </thead>
                          <tbody>
                              <t t-set="seqCount" t-value="0" />
                              <t t-foreach="docs.invoice_line_ids" t-as="line">
                                  <t t-set="seqCount" t-value="seqCount+1" />
                                  <tr align="right">
                                      <!--مبلغ الضريبة -->
                                      <!-- تاريخ إنجاز العمل -->
                                      <td>
                                          <t t-esc="line.price_unit * line.quantity+line.amount_tax"
                                             t-options='{"widget": "float", "precision": 2}'/>    <!--<t t-esc="formatlang(line.discount,digits=4)"/>-->
          
                                        </td>
                                      <td><span t-field="line.amount_tax" t-options='{"widget": "float", "precision": 2}'/></td>
                                      <td><span t-field="line.tax_ids" /></td>
                                      <td><t t-esc="line.price_unit * line.quantity " t-options='{"widget": "float", "precision": 2}'/></td>
                                      <td><t t-esc="line.discount" t-options='{"widget": "float", "precision": 2}'/></td>
                                      <td><span t-field="line.quantity" /></td>
                                      <td><span t-field="line.price_unit"/></td>
                                      <td><span t-field="line.name"/></td>
                                      <td><span t-esc="seqCount"/></td>
  
                                  </tr>
                              </t>
                          </tbody>
                      </table>
                  <!-- </div> -->
                  <!-- Table: Quotation Lines -->
                  
                  
                  <table class="table" style=" font-size:20px;float: right;width: 100%; border: 2px solid #000;">
                      <tbody>
                          <tr>
                              <tr style="border: 2px solid #000;">
                                  <td>						 
                                      <t t-esc="docs.amount_discount + docs.amount_untaxed"
                                      t-options='{"widget": "float", "precision": 2}'/></td>
                                      <th>:الإجمالي بدون الضريبة بالريال السعودي</th>
                              </tr>
                              <tr style="border: 2px solid #000;">
                                  <td><t t-esc="docs.amount_untaxed"/></td>
                                  <th>:ضريبة القيمة المضافة %15 بالريال السعودي</th>
                              </tr>
                              <tr>
                                  <td><t t-esc="docs.amount_discount" t-options='{"widget": "float", "precision": 2}'/></td>
                                  <th>:الحسومات</th>
                              </tr>
                              <tr style="border: 2px solid #000;">
                                  <td><t t-esc="docs.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/></td>
                                  <th>: اجمالي قيمة الفاتورة بعد الحسومات</th>
                              </tr>
                              <tr style="border: 2px solid #000;">
                                  <td><t t-esc="docs .amount_total" t-options='{"widget": "float", "precision": 2}'/></td>
                                  <th>:إجمالي قيمة الفاتورة شامل ضريبة القيمة المضافة %15 بالريال السعودي</th>
                              </tr>
  
  
  
                          </tr>
  
                      </tbody>
                  </table>
  
                  
                  </div>
  
                  <div style="text-align: right; margin-top: 700px;">
                      <p>Printed Date and Time: <t t-esc="docs.get_current_datetime()"/></p>
                  </div>
                                        <div class="footer">
        <div class="text-center" style="border-top: 1px solid black;">        

            <ul class="list-inline">
                <li>Page:
                <span class="page"/>
                <span>/</span>
                <span class="topage"/>
                </li>
            </ul>
        </div>
    </div>   
                </body>
              </div>
            </t>
          </t>
        </t>
      </template>
    </data>
  </odoo>
