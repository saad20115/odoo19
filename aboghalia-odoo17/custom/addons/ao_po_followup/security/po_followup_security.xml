<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_po_followup" model="ir.module.category">
        <field name="name">PO Follow-up</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_po_followup_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_po_followup"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_po_followup_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_po_followup"/>
        <field name="implied_ids" eval="[(4, ref('group_po_followup_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
