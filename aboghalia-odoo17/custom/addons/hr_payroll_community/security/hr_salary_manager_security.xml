<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_salary_manager" model="res.groups">
        <field name="name">Salary Manager</field>
        <field name="category_id" ref="hr_payroll_community.module_category_hr_payroll_community"/>
        <field name="implied_ids" eval="[(4, ref('hr_contract.group_hr_contract_manager'))]"/>
    </record>

    <record id="group_hr_employees_only" model="res.groups">
        <field name="name">HR (Employees Only)</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids"
               eval="[(4, ref('hr.group_hr_manager')), (4, ref('hr_contract.group_hr_contract_manager'))]"/>
    </record>

    <!-- Ensure Payroll Manager users keep all-employee Open Contract visibility -->
    <record id="group_hr_payroll_community_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_payroll_community.group_hr_salary_manager'))]"/>
    </record>

    <!-- Restrict the Employees root menu to Salary Manager and HR-only members -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('hr_payroll_community.group_hr_salary_manager'), ref('hr_payroll_community.group_hr_employees_only')])]"/>
    </record>
</odoo>
