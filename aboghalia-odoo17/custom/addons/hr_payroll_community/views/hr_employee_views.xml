<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee View -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_hr_payslip)d"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        type="action"
                        groups="hr_payroll_community.group_hr_payroll_community_user">
                    <field name="payslip_count" widget="statinfo"
                           string="Payslips"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="payslip_name"/>
                <field name="salary_receive_method_id"/>
            </xpath>
        </field>
    </record>

    <!-- Open Contract: Salary Manager = all employees; others = own record only -->
    <record id="hr_hr_employee_view_form3_salary_manager" model="ir.ui.view">
        <field name="name">hr.employee.form.salary.manager.contract</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_contract.hr_hr_employee_view_form3"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_contract']" position="attributes">
                <attribute name="groups"></attribute>
                <attribute name="invisible">employee_type not in ['employee', 'student', 'trainee'] or not show_open_contract_button</attribute>
            </xpath>
            <xpath expr="//button[@name='action_open_contract']" position="before">
                <field name="show_open_contract_button" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
