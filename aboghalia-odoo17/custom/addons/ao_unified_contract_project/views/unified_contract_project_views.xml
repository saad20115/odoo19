<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Unified Contract Project Form View -->
    <record id="view_unified_contract_project_form" model="ir.ui.view">
        <field name="name">unified.contract.project.form</field>
        <field name="model">unified.contract.project</field>
        <field name="arch" type="xml">
            <form string="مشروع العقد الموحد">
                <header>
                    <field name="is_first_stage" invisible="1"/>
                    <field name="is_last_stage" invisible="1"/>
                    <field name="next_stage_name" invisible="1"/>
                    <field name="prev_stage_name" invisible="1"/>
                    <button name="action_next_stage" type="object" class="btn-primary" invisible="is_last_stage or state in ('done', 'cancel')">
                        <field name="next_stage_name"/>
                    </button>
                    <button name="action_open_revert_wizard" type="object" class="btn-secondary" invisible="is_first_stage or state in ('done', 'cancel')">
                        <field name="prev_stage_name"/>
                    </button>
                    <button name="action_reactivate" string="إعادة تفعيل المشروع 🔄" type="object" class="btn-primary" invisible="state != 'cancel'"/>
                    <button name="action_set_on_hold" string="تعليق ⏸️" type="object" class="btn-warning" invisible="state in ('on_hold', 'done', 'cancel')"/>
                    <button name="action_set_done" string="إكمال المشروع ✔️" type="object" class="btn-success" invisible="state in ('done', 'cancel')"/>
                    <button name="action_set_cancel" string="إلغاء المشروع ❌" type="object" class="btn-danger" invisible="state == 'cancel'"/>
                    <field name="stage_id" widget="statusbar" readonly="1" options="{'clickable': '0'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_work_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="work_order_count" widget="statinfo" string="أوامر العمل"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="اسم مشروع العقد الموحد"/>
                        <h1>
                            <field name="name" placeholder="مثال: مشروع توريد وإحلال الكابلات الموحد - مكة"/>
                        </h1>
                    </div>
                    <group>
                        <group string="بيانات العقد الرئيسية">
                            <field name="code" placeholder="مثال: UC-2026-9041"/>
                            <field name="contract_date"/>
                            <field name="contract_end_date"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group string="بيانات المالكة والإدارة والمقاولين">
                            <field name="contract_entity" placeholder="مثال: وزارة الشؤون البلدية والقروية"/>
                            <field name="partner_id"/>
                            <field name="manager_id"/>
                            <field name="contractor_ids" widget="many2many_tags" placeholder="اختر المقاولين المعتمدين لتنفيذ أوامر العمل..."/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="إدارة فريق العمل" name="stage_teams_page">
                            <field name="team_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="leader_id"/>
                                    <field name="member_ids" widget="many2many_tags"/>
                                    <field name="member_count"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Unified Contract Project Tree View -->
    <record id="view_unified_contract_project_tree" model="ir.ui.view">
        <field name="name">unified.contract.project.tree</field>
        <field name="model">unified.contract.project</field>
        <field name="arch" type="xml">
            <tree string="مشاريع العقود الموحدة" multi_edit="1" sample="1">
                <field name="code" optional="show"/>
                <field name="name" optional="show"/>
                <field name="contract_entity" optional="show"/>
                <field name="contract_date" optional="show"/>
                <field name="contract_end_date" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="manager_id" optional="show"/>
                <field name="contractor_ids" widget="many2many_tags" optional="show"/>
                <field name="work_order_count" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="stage_id" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-info="state == 'in_progress'" decoration-danger="state in ('on_hold', 'cancel')" decoration-success="state == 'done'" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Unified Contract Project Calendar View -->
    <record id="view_unified_contract_project_calendar" model="ir.ui.view">
        <field name="name">unified.contract.project.calendar</field>
        <field name="model">unified.contract.project</field>
        <field name="arch" type="xml">
            <calendar string="تقويم المشاريع" date_start="contract_date" date_stop="contract_end_date" color="stage_id" quick_create="false">
                <field name="name"/>
                <field name="code"/>
                <field name="contract_entity"/>
                <field name="manager_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Unified Contract Project Graph View -->
    <record id="view_unified_contract_project_graph" model="ir.ui.view">
        <field name="name">unified.contract.project.graph</field>
        <field name="model">unified.contract.project</field>
        <field name="arch" type="xml">
            <graph string="مؤشرات أداء المشاريع" type="bar" sample="1">
                <field name="stage_id"/>
                <field name="state"/>
                <field name="work_order_count" type="measure"/>
                <field name="team_count" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Unified Contract Project Pivot View -->
    <record id="view_unified_contract_project_pivot" model="ir.ui.view">
        <field name="name">unified.contract.project.pivot</field>
        <field name="model">unified.contract.project</field>
        <field name="arch" type="xml">
            <pivot string="التحليل المحوري للمشاريع" sample="1">
                <field name="stage_id" type="row"/>
                <field name="state" type="col"/>
                <field name="work_order_count" type="measure"/>
                <field name="team_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Unified Contract Project Search View -->
    <record id="view_unified_contract_project_search" model="ir.ui.view">
        <field name="name">unified.contract.project.search</field>
        <field name="model">unified.contract.project</field>
        <field name="arch" type="xml">
            <search string="بحث المشاريع">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="contract_entity"/>
                <field name="manager_id"/>
                <field name="stage_id"/>
                
                <filter string="جديد / تحت الإعداد" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="قيد التنفيذ" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="معلق" name="on_hold" domain="[('state', '=', 'on_hold')]"/>
                <filter string="مكتمل" name="done" domain="[('state', '=', 'done')]"/>
                
                <group expand="0" string="تجميع حسب">
                    <filter string="الجهة المالكة" name="group_entity" context="{'group_by': 'contract_entity'}"/>
                    <filter string="مدير المشروع" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="المرحلة الحالية" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="حالة المشروع" name="group_state" context="{'group_by': 'state'}"/>
                </group>
                
                <searchpanel>
                    <field name="stage_id" icon="fa-tasks" enable_counters="1"/>
                    <field name="state" icon="fa-info-circle" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_unified_contract_project" model="ir.actions.act_window">
        <field name="name">مشاريع العقد الموحد (Unified Contract Projects)</field>
        <field name="res_model">unified.contract.project</field>
        <field name="view_mode">tree,kanban,calendar,pivot,graph,form</field>
        <field name="search_view_id" ref="view_unified_contract_project_search"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                إضافة مشروع عقد موحد جديد!
            </p>
            <p>
                قم بإدارة وتتبع مشاريع العقود الموحدة وأوامر العمل بشكل مستقل كلياً.
            </p>
        </field>
    </record>

    <!-- Stage Action -->
    <record id="action_unified_contract_stages" model="ir.actions.act_window">
        <field name="name">مراحل المشاريع (Stages)</field>
        <field name="res_model">unified.contract.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Project Reporting Action -->
    <record id="action_unified_contract_project_reporting" model="ir.actions.act_window">
        <field name="name">تقارير ومؤشرات أداء المشاريع 📈</field>
        <field name="res_model">unified.contract.project</field>
        <field name="view_mode">graph,pivot,tree,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_unified_contract_project_search"/>
        <field name="context">{'search_default_group_by_stage': 1}</field>
    </record>

</odoo>
