<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_unified_contract_invoice" model="ir.sequence">
            <field name="name">تسلسل طلبات الفواتير</field>
            <field name="code">unified.contract.invoice</field>
            <field name="prefix">REQ-INV-%(year)s-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Automated Cron Job for Invoice Overdue Calculation -->
        <record id="cron_check_overdue_invoices" model="ir.cron">
            <field name="name">الفواتير: فحص وحساب التأخير والاحتساب التلقائي (60 يوم)</field>
            <field name="model_id" ref="model_unified_contract_invoice"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
