<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Location Range Form View -->
    <record id="view_hr_location_range_form" model="ir.ui.view">
        <field name="name">hr.location.range.form</field>
        <field name="model">hr.location.range</field>
        <field name="arch" type="xml">
            <form string="Location Range">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="allowed_distance"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Assigned Employees">
                            <field name="employee_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Location Range Tree View -->
    <record id="view_hr_location_range_tree" model="ir.ui.view">
        <field name="name">hr.location.range.tree</field>
        <field name="model">hr.location.range</field>
        <field name="arch" type="xml">
            <tree string="Location Ranges">
                <field name="name"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="allowed_distance"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Location Range Search View -->
    <record id="view_hr_location_range_search" model="ir.ui.view">
        <field name="name">hr.location.range.search</field>
        <field name="model">hr.location.range</field>
        <field name="arch" type="xml">
            <search string="Location Ranges">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Location Range Action -->
    <record id="action_hr_location_range" model="ir.actions.act_window">
        <field name="name">Location Ranges</field>
        <field name="res_model">hr.location.range</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first location range
            </p>
            <p>
                Define location ranges where employees are allowed to check-in.
            </p>
        </field>
    </record>

    <!-- Employee Form View Inheritance -->
    <record id="view_employee_form_location_ranges" model="ir.ui.view">
        <field name="name">hr.employee.form.location.ranges</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Location Ranges" groups="hr_attendance.group_hr_attendance_manager">
                    <group>
                        <field name="free_attendance"/>
                        <field name="skip_biometric"/>
                        <field
                            name="use_specific_locations"
                            readonly="free_attendance == True"
                        />
                    </group>
                    <field name="location_range_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           invisible="use_specific_locations == False"
                           required="use_specific_locations == True"
                    />
                    <div class="alert alert-info" role="alert" invisible="use_specific_locations == True">
                        This employee will use the default company location settings.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

