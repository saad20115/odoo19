<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_email_server_form_inherit_incoming_mail_store" model="ir.ui.view">
        <field name="name">fetchmail.server.form.inherit.incoming.mail.store</field>
        <field name="model">fetchmail.server</field>
        <field name="inherit_id" ref="mail.view_email_server_form"/>
        <field name="arch" type="xml">
            <field name="server" position="after">
                <field name="provider"/>
            </field>
        </field>
    </record>

    <record id="view_email_server_tree_inherit_incoming_mail_store" model="ir.ui.view">
        <field name="name">fetchmail.server.tree.inherit.incoming.mail.store</field>
        <field name="model">fetchmail.server</field>
        <field name="inherit_id" ref="mail.view_email_server_tree"/>
        <field name="arch" type="xml">
            <field name="server_type" position="after">
                <field name="provider"/>
            </field>
        </field>
    </record>

</odoo>
