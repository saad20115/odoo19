<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_incoming_mail_reply_wizard_form" model="ir.ui.view">
        <field name="name">incoming.mail.reply.wizard.form</field>
        <field name="model">incoming.mail.reply.wizard</field>
        <field name="arch" type="xml">
            <form string="Reply by Email">
                <group>
                    <field name="incoming_mail_id"/>
                    <field name="mail_server_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="email_from"/>
                    <field name="email_to"/>
                    <field name="subject"/>
                </group>
                <label for="body" string="Message"/>
                <field name="body" widget="html" options="{'style-inline': true}"/>
                <footer>
                    <button name="action_send_reply" type="object" string="Send Reply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
