<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fetchmail_fetch_wizard_form" model="ir.ui.view">
        <field name="name">fetchmail.fetch.wizard.form</field>
        <field name="model">fetchmail.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Fetch Date Range">
                <group>
                    <field name="fetchmail_server_id"
                        options="{'no_create': True, 'no_open': True}"
                        placeholder="Select incoming mail server..."/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_fetch" type="object" string="Fetch Emails" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
