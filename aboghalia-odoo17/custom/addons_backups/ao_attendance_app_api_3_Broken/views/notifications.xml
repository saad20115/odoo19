<odoo>
    <record id="shift_start_reminder_notification" model="ir.cron">
        <field name="name">Shift start reminder</field>
        <field name="model_id" ref="model_hr_employee" />
        <field name="state">code</field>
        <field name="code">model.send_start_shift_notification()</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:55:00')" />
        <field name='interval_type'>days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="shift_end_reminder_notification" model="ir.cron">
        <field name="name">Shift end reminder</field>
        <field name="model_id" ref="model_hr_employee" />
        <field name="state">code</field>
        <field name="code">model.send_end_shift_notification()</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 12:55:00')" />
        <field name='interval_type'>days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="location_verification_notification" model="ir.cron">
        <field name="name">Out of location notification</field>
        <field name="model_id" ref="model_hr_employee" />
        <field name="state">code</field>
        <field name="code">model.send_location_verification_notification()</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
        <field name='interval_number'>30</field>
        <field name='interval_type'>minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
</odoo>