<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="attendance_grid_report_pdf" name="ao_work_entries_pdf.attendance_grid_report_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <t t-set="emps" t-value="employees or []"/>
                <t t-set="days" t-value="days_in_month or []"/>
                <t t-set="attendance" t-value="attendance_data or {}"/>
                <t t-set="summaries" t-value="monthly_summaries or {}"/>
                <t t-set="report_year" t-value="year"/>
                <t t-set="report_month" t-value="month"/>
                <t t-set="report_period"
                   t-value="(report_year and report_month) and ('%s-%02d' % (report_year, report_month)) or ''"/>

                <style>
                    body{
                    font-family: DejaVu Sans, Arial, sans-serif;
                    color:#333;
                    -webkit-print-color-adjust: exact !important;
                    print-color-adjust: exact !important;
                    }
                    @page { size: A4 landscape; margin: 10mm 8mm; }

                    .ag-table{
                    width:100%;
                    border-collapse: collapse;
                    table-layout: fixed;
                    font-size: 9px;
                    }
                    .ag-table thead th{
                    background:#9b8fc9 !important;
                    color:#fff !important;
                    font-weight:600;
                    border: 1px solid #8a7fb8;
                    padding: 10px 4px;
                    text-align:center;
                    font-size: 9px;
                    vertical-align: middle;
                    }
                    .ag-table tbody td{
                    border: 1px solid #e5e5e5;
                    padding: 8px 4px;
                    vertical-align: middle;
                    text-align:center;
                    background:#fff;
                    }

                    /* Employee column */
                    .col-emp{
                    width: 180px;
                    text-align:left;
                    background:#fff !important;
                    }
                    .emp-wrap{
                    display:flex;
                    align-items:center;
                    gap:10px;
                    }
                    .emp-photo{
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    object-fit: cover;
                    display:block;
                    background:#f5f5f5;
                    flex: 0 0 36px;
                    }
                    .emp-avatar{
                    width: 36px;
                    height: 36px;
                    border-radius: 50%;
                    background:#e8e8e8;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-weight: 700;
                    color:#666;
                    font-size: 14px;
                    flex: 0 0 36px;
                    }
                    .emp-meta{
                    text-align:left;
                    flex: 1;
                    }
                    .emp-name{
                    font-weight: 900;
                    font-size: 11px;
                    line-height:1.3;
                    margin:0;
                    color:#000;
                    }
                    .emp-dept{
                    font-size: 9px;
                    color:#888;
                    margin-top:2px;
                    white-space:nowrap;
                    overflow:hidden;
                    text-overflow:ellipsis;
                    }

                    /* Summary columns */
                    .col-sum{
                    width: 65px;
                    font-weight: 700;
                    font-size: 12px;
                    }
                    .col-sum.sum-abs{ background:#fef9e7 !important; color:#000; }
                    .col-sum.sum-late{ background:#f8f8f8 !important; color:#000; }
                    .col-sum.sum-ot{ background:#e8f4fd !important; color:#000; }

                    /* Day cells */
                    .col-day{
                    width: 24px;
                    padding: 0 !important;
                    height: 38px;
                    }

                    .cell{
                    width: 100%;
                    height: 38px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-weight: 900;
                    color:#fff;
                    border: 0 !important;
                    position: relative;
                    font-size: 18px;
                    }

                    /* Status colors - exact match */
                    .st-present{ background:#4caf50 !important; }
                    .st-absent{ background:#f44336 !important; }
                    .st-weekend{ background:#bdbdbd !important; }
                    .st-leave{ background:#42a5f5 !important; }
                    .st-holiday{ background:#ffa726 !important; }
                    .st-checked{ background:#66bb6a !important; }
                    .st-empty{ background:#ffffff !important; border: 1px solid #e5e5e5 !important; }

                    /* Day headers */
                    .day-h{
                    font-size: 9px;
                    font-weight: 600;
                    }

                    /* Legend */
                    .ag-legend{
                    display:flex;
                    gap:15px;
                    margin: 12px 0;
                    font-size: 10px;
                    padding: 8px 0;
                    }
                    .ag-legend-item{
                    display:flex;
                    align-items:center;
                    gap:6px;
                    }
                    .ag-dot{
                    width:14px;
                    height:14px;
                    border-radius:2px;
                    display:inline-block;
                    }
                    .d-present{ background:#4caf50; }
                    .d-absent{ background:#f44336; }
                    .d-weekend{ background:#bdbdbd; }
                    .d-leave{ background:#42a5f5; }
                    .d-holiday{ background:#ffa726; }
                    .d-checked{ background:#66bb6a; }
                </style>

                <div t-if="not emps"
                     style="padding: 22px; text-align:center; border: 2px dashed #f44336; border-radius:8px; color:#f44336; font-size:13px;">
                    <strong>No employees match the selected filters.</strong>
                    <br/>
                    Check Department / Search filters and user access rights.
                </div>

                <table class="ag-table" t-if="emps">
                    <thead>
                        <tr>
                            <th class="col-emp" style="text-align:left;">Employee</th>
                            <th class="col-sum">Absence<br/>Total
                            </th>
                            <th class="col-sum">Late Hours<br/>Total
                            </th>
                            <th class="col-sum">Overtime<br/>Hours
                            </th>
                            <t t-foreach="days" t-as="day_num">
                                <th class="col-day">
                                    <span class="day-h">
                                        <t t-esc="day_num"/>
                                    </span>
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="emps" t-as="emp">
                            <t t-set="emp_id" t-value="emp.get('id')"/>
                            <t t-set="emp_sum" t-value="(summaries.get(emp_id) or summaries.get(str(emp_id)) or {})"/>
                            <t t-set="emp_att" t-value="(attendance.get(emp_id) or attendance.get(str(emp_id)) or {})"/>

                            <tr>
                                <td class="col-emp">
                                    <div class="emp-wrap">
                                        <t t-set="img64" t-value="emp.get('image_base64')"/>
                                        <t t-if="img64">
                                            <img class="emp-photo" t-att-src="'data:image/png;base64,%s' % img64"/>
                                        </t>
                                        <t t-else="">
                                            <div class="emp-avatar">
                                                <t t-set="nm" t-value="emp.get('name') or ''"/>
                                                <t t-esc="(nm and nm[:1].upper()) or '?'"/>
                                            </div>
                                        </t>

                                        <div class="emp-meta">
                                            <div class="emp-name">
                                                <t t-esc="emp.get('name','N/A')"/>
                                            </div>

                                            <div class="emp-dept" t-if="emp.get('job_title')">
                                                <t t-esc="emp.get('job_title')"/>
                                            </div>

                                            <div class="emp-dept" t-if="emp.get('department_name')">
                                                <t t-esc="emp.get('department_name')"/>
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <td class="col-sum sum-abs">
                                    <t t-esc="emp_sum.get('total_absence_days', 0)"/>
                                </td>
                                <td class="col-sum sum-late">
                                    <t t-esc="'%.1f' % (emp_sum.get('total_late_hours', 0.0) or 0.0)"/>
                                </td>
                                <td class="col-sum sum-ot">
                                    <t t-esc="'%.1f' % (emp_sum.get('total_overtime_hours', 0.0) or 0.0)"/>
                                </td>

                                <t t-foreach="days" t-as="day_num">
                                    <t t-set="day_data"
                                       t-value="(emp_att.get(day_num) or emp_att.get(str(day_num)) or {})"/>
                                    <t t-set="status" t-value="(day_data.get('status') or '')"/>
                                    <t t-set="hours" t-value="(day_data.get('hours') or 0.0)"/>

                                    <td class="col-day">
                                        <t t-if="status">
                                            <div t-attf-class="cell st-{{status}}">
                                                <t t-if="status == 'present'">✓</t>
                                                <t t-elif="status == 'absent'">✕</t>
                                                <t t-elif="status == 'weekend'">🛏</t>
                                                <t t-elif="status == 'leave'">✈</t>
                                                <t t-elif="status == 'holiday'">★</t>
                                                <t t-elif="status == 'checked'">✓</t>
                                                <t t-else="">-</t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="cell st-empty"></div>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="ag-legend">
                    <div class="ag-legend-item">
                        <span class="ag-dot d-present"></span>
                        Present
                    </div>
                    <div class="ag-legend-item">
                        <span class="ag-dot d-absent"></span>
                        Absent
                    </div>
                    <div class="ag-legend-item">
                        <span class="ag-dot d-holiday"></span>
                        Holiday
                    </div>
                    <div class="ag-legend-item">
                        <span class="ag-dot d-leave"></span>
                        Leave
                    </div>
                    <div class="ag-legend-item">
                        <span class="ag-dot d-weekend"></span>
                        Weekend
                    </div>
                    <div class="ag-legend-item">
                        <span class="ag-dot d-checked"></span>
                        Checked in during Leave/Holiday
                    </div>
                </div>

            </t>
        </t>
    </template>
</odoo>