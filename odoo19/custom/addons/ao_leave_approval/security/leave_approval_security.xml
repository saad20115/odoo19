<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_leave_project_manager" model="res.groups">
        <field name="name">Leave Project Manager</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can approve time off requests at the Project Manager level.</field>
    </record>

    <record id="group_leave_general_manager" model="res.groups">
        <field name="name">Leave General Manager</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can approve time off requests at the General Manager level.</field>
    </record>

    <record id="group_leave_hr_manager" model="res.groups">
        <field name="name">Leave HR Managers</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can approve time off requests at the HR Managers level (final approval).</field>
    </record>

    <record id="hr_leave_rule_project_manager" model="ir.rule">
        <field name="name">Leave Project Manager: all employee time off</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('holiday_type', '=', 'employee')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_leave_project_manager'))]"/>
    </record>

    <record id="hr_leave_rule_general_manager" model="ir.rule">
        <field name="name">Leave General Manager: all employee time off</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('holiday_type', '=', 'employee')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_leave_general_manager'))]"/>
    </record>

    <record id="hr_leave_rule_hr_manager" model="ir.rule">
        <field name="name">Leave HR Managers: all employee time off</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('holiday_type', '=', 'employee')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(4, ref('group_leave_hr_manager'))]"/>
    </record>
</odoo>
