<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_view_form_leave_approval" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.ao.leave.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_approve']" position="replace">
                <button string="Approve" name="action_approve" type="object"
                        class="oe_highlight"
                        invisible="not active or not can_decide or state != 'confirm'"/>
            </xpath>
            <xpath expr="//button[@name='action_refuse']" position="replace">
                <button string="Refuse" name="action_refuse" type="object"
                        invisible="not active or not can_decide or state != 'confirm'"/>
            </xpath>
            <xpath expr="//button[@name='action_validate']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="can_decide" invisible="1"/>
                <field name="current_level" widget="badge"
                       decoration-info="current_level == 'manager'"
                       decoration-warning="current_level in ('project_manager', 'general_manager', 'hr_manager')"
                       decoration-success="current_level == 'done'"
                       invisible="not current_level or current_level == 'none'"/>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="requires_allocation" invisible="1"/>
                <field name="remaining_leave_days" readonly="1"
                       invisible="not holiday_status_id or requires_allocation == 'no'"/>
            </xpath>
            <xpath expr="//button[@name='action_full_admin_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook[.//field[@name='validation_status_ids']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_view_tree_leave_approval" model="ir.ui.view">
        <field name="name">hr.leave.view.tree.inherit.ao.leave.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="can_decide" column_invisible="True"/>
                <field name="current_level" optional="show"/>
            </xpath>
            <xpath expr="//button[@name='action_approve']" position="replace">
                <button string="Approve" name="action_approve" type="object"
                        icon="fa-thumbs-up"
                        invisible="not can_decide or state != 'confirm'"/>
            </xpath>
            <xpath expr="//button[@name='action_validate']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_refuse']" position="replace">
                <button string="Refuse" name="action_refuse" type="object"
                        icon="fa-times"
                        invisible="not can_decide or state != 'confirm'"/>
            </xpath>
        </field>
    </record>
</odoo>
