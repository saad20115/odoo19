<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_sec_unified_project" model="ir.sequence">
        <field name="name">SEC Master Project Sequence</field>
        <field name="code">sec.unified.project</field>
        <field name="prefix">PRJ-SEC-%(year)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_sec_work_order" model="ir.sequence">
        <field name="name">SEC Work Order Sequence</field>
        <field name="code">sec.work.order</field>
        <field name="prefix">WO-SEC-%(year)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
