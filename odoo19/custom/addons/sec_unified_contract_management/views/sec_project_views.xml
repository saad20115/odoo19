<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sec_unified_project_form" model="ir.ui.view">
        <field name="name">sec.unified.project.form</field>
        <field name="model">sec.unified.project</field>
        <field name="arch" type="xml">
            <form string="المشروع الرئيسي للعقد الموحد">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_work_orders" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="work_order_count" string="أوامر العمل" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="اسم المشروع / العقد الموحد"/>
                        <h1>
                            <field name="name" placeholder="مثال: مشروع العقد الموحد - مكة المكرمة"/>
                        </h1>
                        <h3>
                            <field name="code" readonly="1" class="text-muted"/>
                        </h3>
                    </div>
                    <group>
                        <group string="بيانات العقد والجهة">
                            <field name="region"/>
                            <field name="sec_contract_number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="الإدارة والمدة المالية">
                            <field name="manager_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="contract_value" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="أوامر العمل التابعة" name="work_orders">
                            <field name="work_order_ids" readonly="1">
                                <tree string="أوامر العمل" decoration-info="state in ('draft', 'survey')" decoration-warning="state in ('execution', 'closing')" decoration-success="state in ('invoicing', 'collection', 'done')" decoration-danger="state == 'cancelled'">
                                    <field name="name"/>
                                    <field name="sec_work_order_no"/>
                                    <field name="sec_notification_no"/>
                                    <field name="order_title"/>
                                    <field name="contractor_id"/>
                                    <field name="progress_percentage" widget="progressbar"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="الملاحظات والشروط" name="notes">
                            <field name="notes" placeholder="ملاحظات وشروط المشروع الخاصة..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_sec_unified_project_tree" model="ir.ui.view">
        <field name="name">sec.unified.project.tree</field>
        <field name="model">sec.unified.project</field>
        <field name="arch" type="xml">
            <tree string="المشاريع والعقود الموحدة">
                <field name="code"/>
                <field name="name"/>
                <field name="region"/>
                <field name="sec_contract_number"/>
                <field name="manager_id"/>
                <field name="work_order_count"/>
                <field name="contract_value" widget="monetary"/>
                <field name="state" widget="badge" decoration-success="state == 'running'" decoration-muted="state == 'closed'"/>
            </tree>
        </field>
    </record>

    <record id="view_sec_unified_project_kanban" model="ir.ui.view">
        <field name="name">sec.unified.project.kanban</field>
        <field name="model">sec.unified.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="region"/>
                <field name="work_order_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click p-3 shadow-sm rounded border">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title text-primary fs-5"><field name="name"/></strong>
                                    <div class="text-muted"><field name="code"/></div>
                                </div>
                                <span t-if="record.state.raw_value == 'running'" class="badge bg-success">ساري</span>
                                <span t-if="record.state.raw_value == 'closed'" class="badge bg-secondary">مغلق</span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-map-marker text-danger me-1" title="المنطقة"></i> <field name="region"/></div>
                                <div><i class="fa fa-tasks text-info me-1" title="أوامر العمل"></i> أوامر العمل: <strong><field name="work_order_count"/></strong></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>