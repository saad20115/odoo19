<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Stub only: keep these groups so Odoo does not try to delete them.
        Access rights live in ao_po_followup. Ignore this module in Apps.
    -->
    <record id="module_category_po_order" model="ir.module.category">
        <field name="name">PO Order</field>
        <field name="sequence">99</field>
    </record>

    <record id="group_po_order_user" model="res.groups">
        <field name="name">User (ignore)</field>
        <field name="category_id" ref="module_category_po_order"/>
    </record>

    <record id="group_po_order_manager" model="res.groups">
        <field name="name">Administrator (ignore)</field>
        <field name="category_id" ref="module_category_po_order"/>
        <field name="implied_ids" eval="[(4, ref('group_po_order_user'))]"/>
    </record>
</odoo>
