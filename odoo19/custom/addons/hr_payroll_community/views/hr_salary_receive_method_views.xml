<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_receive_method_view_tree" model="ir.ui.view">
        <field name="name">hr.salary.receive.method.view.tree</field>
        <field name="model">hr.salary.receive.method</field>
        <field name="arch" type="xml">
            <tree string="Salary Receive Method" editable="bottom">
                <field name="name"/>
                <field name="note"/>
                <field name="employee_ids_m2m" widget="many2many_tags"
                       options="{'no_create': True}"/>
            </tree>
        </field>
    </record>

    <record id="action_hr_salary_receive_method" model="ir.actions.act_window">
        <field name="name">Salary Receive Method</field>
        <field name="res_model">hr.salary.receive.method</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a salary receive method
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_salary_receive_method"
              name="Salary Receive Method"
              parent="menu_hr_payroll_community_configuration"
              action="action_hr_salary_receive_method"
              sequence="50"
              groups="hr_payroll_community.group_hr_payroll_community_user"/>
</odoo>
