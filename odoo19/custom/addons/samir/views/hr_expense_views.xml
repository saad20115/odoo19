<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="hr_expense_view_form_so" model="ir.ui.view">
        <field name="name">hr.expense.view.form</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='y_section']" position="replace">
                <field name="y_section" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='total_amount_currency']" position="replace">
                <field name="total_amount_currency" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='priority']" position="replace">
                <field name="priority" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='x_exchange_method']" position="replace">
                <field name="x_exchange_method" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="replace">
                <field name="employee_id" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='x_state']" position="replace">
                <field name="x_state" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="readonly">state=='done'</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="replace">
                <field name="date" string="التاريخ" readonly="state=='done'" options="{'format': 'DD/MM/YYYY'}"/>
            </xpath>
            <xpath expr="//field[@name='x_request_type']" position="replace">
                <field name="x_request_type" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="replace">
                <field name="name" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='x_notes']" position="replace">
                <field name="x_notes" readonly="state=='done'"/>
            </xpath>
            <xpath expr="//field[@name='x_responses']" position="replace">
                <field name="x_responses" readonly="state=='done'"/>
                <field name="customer_id" string="المورد" readonly="state=='done'"/>
                <field name="state_convent" readonly="state == 'done'"/>
                <field name="acc_no_from_partner_bank" readonly="1"/>
                <field name="manager" invisible="manager == False"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_view_tree_so" model="ir.ui.view">
        <field name="name">hr.expense.view.form</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.view_my_expenses_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='total_amount_currency']" position="replace">
                <field name="total_amount_currency" widget="monetary"
                       readonly="not is_editable or not is_multiple_currency or product_has_cost"
                       options="{'currency_field': 'currency_id'}" string="المبلغ" optional="hide" decoration-bf="1"
                       groups="base.group_multi_currency"/>
                <field name="y_section" string="القسم" optional="show"
                       options="{'fg_color': 'white:color_selection == \'1\';white:color_selection == \'2\';white:color_selection == \'3\';white:color_selection == \'4\';white:color_selection == \'5\';white:color_selection == \'6\';white:color_selection == \'7\'','bg_color': '#000891:color_selection == \'1\';#ccba96:color_selection == \'2\';#21c2cf:color_selection == \'3\';#006769:color_selection == \'4\';#e6e7e8:color_selection == \'5\';#000000:color_selection == \'6\';'}"
                />
                <field name="color_selection" column_invisible="True"/>
                <field name="x_request_type" string="نوعه" optional="show"/>
                <field name="name" string="الوصف" optional="show"/>
                <field name="x_exchange_method" string="طريقة الصرف" optional="show"/>
                <field name="x_state" string="الحالة" optional="show"/>
                <field name="x_notes" string="الملاحظات" optional="show"/>
                <field name="x_responses" string="الردود" optional="show"/>
                <field name="customer_id" string="العميل" optional="show"/>
                <field name="manager" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="hr_expense_search_inherit" model="ir.ui.view">
        <field name="name">hr.expense.search.inherit</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <search>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <filter name="show_archived_active" string="Show Archived &amp; Active"
                        domain="['|',('active', '=', False),('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_hr_employee_filter_inherit" model="ir.ui.view">
        <field name="name">hr.employee.search</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="my_employee" string="Employee"
                        domain="[('user_id', '=', uid)]"/>
            </xpath>
        </field>
    </record>


    <record id="open_view_employee_list_my_inherit" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,tree,form,activity,graph,pivot</field>
        <field name="context">{'chat_icon': True, 'search_default_my_employee': 1}</field>
        <field name="view_id" eval="False"/>
        <field name="search_view_id" ref="hr.view_employee_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new employee
            </p>
            <p>
                With just a quick glance on the Odoo employee screen, you
                can easily find all the information you need for each person;
                contact data, job position, availability, etc.
            </p>
        </field>
    </record>


    <record id="hr.menu_hr_employee_payroll" model="ir.ui.menu">
        <field name="name">Employees</field>
        <field name="parent_id" ref="hr.menu_hr_root"/>
        <field name="action" ref="samir_etislate.open_view_employee_list_my_inherit"/>
        <field name="sequence" eval="1"/>
    </record>


    <record id="hr.menu_hr_employee_user" model="ir.ui.menu">
        <field name="name">Employees</field>
        <field name="parent_id" ref="hr.menu_hr_employee_payroll"/>
        <field name="action" ref="samir_etislate.open_view_employee_list_my_inherit"/>
        <field name="sequence" eval="1"/>
    </record>


</odoo>
