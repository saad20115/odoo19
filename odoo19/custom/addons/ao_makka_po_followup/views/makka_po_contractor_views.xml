<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_po_contractor_tree" model="ir.ui.view">
        <field name="name">makka.po.contractor.tree</field>
        <field name="model">makka.po.contractor</field>
        <field name="arch" type="xml">
            <tree string="Contractors" editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_po_contractor" model="ir.actions.act_window">
        <field name="name">Contractors</field>
        <field name="res_model">makka.po.contractor</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first contractor
            </p>
        </field>
    </record>
</odoo>
