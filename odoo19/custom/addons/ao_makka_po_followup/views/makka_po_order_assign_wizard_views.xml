<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_po_order_assign_wizard_form" model="ir.ui.view">
        <field name="name">makka.po.order.assign.wizard.form</field>
        <field name="model">makka.po.order.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign User">
                <group>
                    <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="order_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_assign"
                            type="object"
                            string="Assign"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
