<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_makka_po_import_fix_wizard_form" model="ir.ui.view">
        <field name="name">makka.po.import.fix.wizard.form</field>
        <field name="model">makka.po.import.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix Import File">
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state == 'done'">
                    Upload the Excel or CSV from بيان PO. This prepares a clean file
                    for Odoo Import (PO numbers, dates, تم/لم يتم, duplicate work orders).
                </div>
                <group invisible="state == 'done'">
                    <field name="data_file" filename="data_filename"/>
                    <field name="data_filename" invisible="1"/>
                </group>
                <div class="alert alert-success" role="alert" invisible="state != 'done'">
                    Download the CSV below, then use Favorites → Import records.
                </div>
                <group invisible="state != 'done'">
                    <field name="summary" widget="text"/>
                    <field name="output_file" filename="output_filename"/>
                    <field name="output_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_fix_file"
                            type="object"
                            string="Fix File"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_makka_po_import_fix_wizard" model="ir.actions.act_window">
        <field name="name">Fix Import File</field>
        <field name="res_model">makka.po.import.fix.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_makka_po_import_fix_wizard_form"/>
    </record>
</odoo>
