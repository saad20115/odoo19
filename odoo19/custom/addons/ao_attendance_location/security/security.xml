<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Record Rule: Personal Location Ranges -->
        <record id="hr_location_range_rule_employee" model="ir.rule">
            <field name="name">Employee: read personal location ranges</field>
            <field name="model_id" ref="model_hr_location_range"/>
            <field name="domain_force">[('employee_ids', 'in', user.employee_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule: All Location Ranges (HR Attendance Manager) -->
        <record id="hr_location_range_rule_manager" model="ir.rule">
            <field name="name">Manager: all location ranges</field>
            <field name="model_id" ref="model_hr_location_range"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        </record>

        <!-- Portal Access -->
        <record id="hr_location_range_rule_portal" model="ir.rule">
            <field name="name">Portal: read assigned location ranges</field>
            <field name="model_id" ref="model_hr_location_range"/>
            <field name="domain_force">[('employee_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>

    <!-- Access Rights -->
    <record id="access_hr_location_range_user" model="ir.model.access">
        <field name="name">hr.location.range.user</field>
        <field name="model_id" ref="model_hr_location_range"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_hr_location_range_manager" model="ir.model.access">
        <field name="name">hr.location.range.manager</field>
        <field name="model_id" ref="model_hr_location_range"/>
        <field name="group_id" ref="hr_attendance.group_hr_attendance_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="access_hr_location_range_portal" model="ir.model.access">
        <field name="name">hr.location.range.portal</field>
        <field name="model_id" ref="model_hr_location_range"/>
        <field name="group_id" ref="base.group_portal"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>