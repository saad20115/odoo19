<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_incoming_mail_assign_wizard_form" model="ir.ui.view">
        <field name="name">incoming.mail.assign.wizard.form</field>
        <field name="model">incoming.mail.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Notify via OdooBot">
                <group>
                    <field name="incoming_mail_id"/>
                    <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                </group>
                <label for="message" string="Message"/>
                <field name="message" widget="html" options="{'style-inline': true}"/>
                <footer>
                    <button name="action_assign" type="object" string="Send via OdooBot" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
