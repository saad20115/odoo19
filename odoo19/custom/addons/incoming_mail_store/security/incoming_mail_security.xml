<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_incoming_mail" model="ir.module.category">
        <field name="name">Incoming Mail</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_incoming_mail_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_incoming_mail"/>
        <field name="comment">Can access the Incoming Mail inbox and related actions.</field>
    </record>

    <record id="incoming_mail_rule_inbox_user" model="ir.rule">
        <field name="name">Incoming Mail: inbox users see all</field>
        <field name="model_id" ref="model_incoming_mail"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_incoming_mail_user'))]"/>
    </record>

    <record id="incoming_mail_rule_system" model="ir.rule">
        <field name="name">Incoming Mail: administrators see all</field>
        <field name="model_id" ref="model_incoming_mail"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="incoming_mail_rule_shared_user" model="ir.rule">
        <field name="name">Incoming Mail: assigned email only</field>
        <field name="model_id" ref="model_incoming_mail"/>
        <field name="domain_force">[('shared_user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
