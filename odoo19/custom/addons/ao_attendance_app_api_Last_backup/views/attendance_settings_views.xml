<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
       <field name="name">
           res.config.settings.view.form.inherit.attendance.api
       </field>
       <field name="model">res.config.settings</field>
       <field name="priority" eval="15"/>
       <field name="inherit_id" ref="base.res_config_settings_view_form"/>
       <field name="arch" type="xml">
           <xpath expr="//form" position="inside">
               <app data-string="Attendance API Management" string="Attendance API Management" name="uuid_management">
                   <block title="Attendance API Management Settings" name="uuid_block">
                       <setting id="uuid_acceptance" string="Accept UUIDs">
                           <field name="is_accept_uuid"/>
                       </setting>
                   </block>
               </app>
           </xpath>
       </field>
    </record>
</odoo>