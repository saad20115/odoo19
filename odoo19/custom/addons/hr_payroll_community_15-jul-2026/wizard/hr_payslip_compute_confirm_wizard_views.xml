<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_compute_confirm_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.compute.confirm.wizard.form</field>
        <field name="model">hr.payslip.compute.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Compute &amp; Confirm Payslips">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <separator string="Selected Employees"/>
                <field name="employee_ids" nolabel="1" readonly="1">
                    <tree>
                        <field name="name"/>
                        <field name="department_id"/>
                        <field name="job_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </tree>
                </field>
                <field name="payslip_ids" invisible="1"/>
                <footer>
                    <button name="action_compute_and_confirm"
                            string="Compute &amp; Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payslip_compute_confirm_wizard" model="ir.actions.act_window">
        <field name="name">Compute &amp; Confirm</field>
        <field name="res_model">hr.payslip.compute.confirm.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_payslip_compute_confirm_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <!-- Appears under Action when selecting payslips in the list -->
    <record id="action_server_hr_payslip_compute_confirm" model="ir.actions.server">
        <field name="name">Compute &amp; Confirm</field>
        <field name="model_id" ref="model_hr_payslip"/>
        <field name="binding_model_id" ref="model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if not records:
    raise UserError("Please select at least one payslip.")
action = {
    'type': 'ir.actions.act_window',
    'name': 'Compute &amp; Confirm',
    'res_model': 'hr.payslip.compute.confirm.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'active_ids': records.ids,
        'active_model': 'hr.payslip',
    },
}
        </field>
    </record>
</odoo>
