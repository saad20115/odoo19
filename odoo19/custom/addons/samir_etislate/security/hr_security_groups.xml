<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Users in this group can pick any employee on expenses (all companies).
         Users not in this group only see / keep themselves. -->
    <record id="module_category_expense_employee_access" model="ir.module.category">
        <field name="name">Expense Employee Access</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_expense_select_any_employee" model="res.groups">
        <field name="name">Select Any Employee on Expenses</field>
        <field name="category_id" ref="module_category_expense_employee_access"/>
        <field name="comment">Allow selecting any employee from any company on expense forms. Users without this group can only create expenses for themselves.</field>
    </record>

    <!-- Read-all employees for expense selectors (OR with other group rules).
         Cross-company global rules are bypassed in Python via sudo on expense form. -->
    <record id="rule_expense_select_any_employee_read" model="ir.rule">
        <field name="name">Expense: read any employee for selector group</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_expense_select_any_employee'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="own_profile_team_members" model="ir.rule">
        <field name="name">See Own Profile And Team Members</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">
            [
            '|',
            ('user_id', '=', user.id),
            ('parent_id.user_id', '=', user.id)
            ]
        </field>
        <field name="perm_create" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="hr_manager_full_access" model="ir.rule">
        <field name="name">HR Manager: Full Access to Employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[]</field>
        <field name="perm_create" eval="True"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="groups" eval="[(6, 0, [ref('hr.group_hr_manager')])]"/>
    </record>

</odoo>
