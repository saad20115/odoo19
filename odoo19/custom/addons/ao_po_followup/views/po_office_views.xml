<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_po_office_tree" model="ir.ui.view">
        <field name="name">po.office.tree</field>
        <field name="model">po.office</field>
        <field name="arch" type="xml">
            <tree string="Offices" editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_po_office" model="ir.actions.act_window">
        <field name="name">Offices</field>
        <field name="res_model">po.office</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first office
            </p>
        </field>
    </record>
</odoo>
