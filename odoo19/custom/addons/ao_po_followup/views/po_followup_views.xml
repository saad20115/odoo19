<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_po_followup_tree" model="ir.ui.view">
        <field name="name">po.followup.tree</field>
        <field name="model">po.followup</field>
        <field name="arch" type="xml">
            <tree string="PO Follow-up"
                  js_class="po_followup_list"
                  class="ao_po_followup_tree"
                  editable="bottom"
                  decoration-success="is_fully_done == True"
                  decoration-danger="attention == True"
                  decoration-muted="state == 'sent_to_portal'"
                  decoration-info="state == 'assigned'"
                  create="1"
                  delete="1">
                <field name="sequence" string="#" width="40px"/>
                <field name="state" readonly="1" widget="badge" width="120px"
                        decoration-info="state == 'assigned'"
                        decoration-success="state == 'sent_to_portal'"
                        decoration-muted="state == 'draft'"/>
                <field name="po_number" required="1" width="100px"/>
                <field name="work_order_number" string="Work Order" width="100px"/>
                <field name="contractor_id" options="{'no_create_edit': False}" width="100px"/>
                <field name="office_id" options="{'no_create_edit': False}" width="80px"/>
                <field name="entity_id" options="{'no_create_edit': False}" width="100px"/>
                <field name="description" width="110px"/>
                <field name="technical_files_uploaded" string="Cloud Files" width="90px"/>
                <field name="tax_invoice" width="90px"/>
                <field name="invoice_number" optional="show" width="100px"/>
                <field name="invoice_date" optional="show" widget="en_us_date" width="90px"/>
                <field name="estimation_date" string="Estimation" optional="hide" widget="en_us_date" width="90px"/>
                <field name="uploaded_to_system" string="On System" width="90px"/>
                <field name="is_fully_done" column_invisible="1"/>
                <field name="expenditure" sum="Total Expenditure" optional="show" width="90px"/>
                <field name="value" sum="Total Value" optional="show" width="90px"/>
                <field name="value_with_tax" string="Value + Tax" sum="Total Value with Tax" optional="show" width="95px" readonly="1"/>
                <field name="remote_invoice_name" string="Acc. Invoice" optional="show" readonly="1" width="110px"/>
                <field name="assign_error" column_invisible="1" readonly="1"/>
                <field name="attention" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_po_followup_search" model="ir.ui.view">
        <field name="name">po.followup.search</field>
        <field name="model">po.followup</field>
        <field name="arch" type="xml">
            <search string="PO Follow-up">
                <field name="po_number"/>
                <field name="work_order_number"/>
                <field name="contractor_id"/>
                <field name="office_id"/>
                <field name="entity_id"/>
                <field name="invoice_number"/>
                <field name="description"/>
                <field name="is_fully_done"/>
                <filter string="Tax Invoice Done"
                        name="tax_invoice_yes"
                        domain="[('tax_invoice', '=', 'yes')]"/>
                <filter string="Uploaded to System"
                        name="uploaded_yes"
                        domain="[('uploaded_to_system', '=', 'yes')]"/>
                <filter string="Technical Files Uploaded"
                        name="tech_files_yes"
                        domain="[('technical_files_uploaded', '=', 'yes')]"/>
                <filter string="All Triple Yes"
                        name="all_triple_yes"
                        domain="[('is_fully_done', '=', True)]"/>
                <filter string="Not All Triple Yes"
                        name="not_all_triple_yes"
                        domain="[('is_fully_done', '=', False)]"/>
                <filter string="Attention"
                        name="attention"
                        domain="[('attention', '=', True)]"/>
                <filter string="Has Expenditure"
                        name="has_expenditure"
                        domain="[('expenditure', '>', 0)]"/>
                <separator/>
                <filter string="Draft"
                        name="state_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned to Accounting"
                        name="state_assigned"
                        domain="[('state', '=', 'assigned')]"/>
                <filter string="Sent to Portal"
                        name="state_sent_to_portal"
                        domain="[('state', '=', 'sent_to_portal')]"/>
                <separator/>
                <filter string="Invoice Date"
                        name="filter_invoice_date"
                        date="invoice_date"/>
                <filter string="Estimation Date"
                        name="filter_estimation_date"
                        date="estimation_date"/>
                <group>
                    <filter string="Contractor"
                            name="group_contractor"
                            context="{'group_by': 'contractor_id'}"/>
                    <filter string="Office"
                            name="group_office"
                            context="{'group_by': 'office_id'}"/>
                    <filter string="Entity"
                            name="group_entity"
                            context="{'group_by': 'entity_id'}"/>
                    <filter string="Invoice Date"
                            name="group_invoice_date"
                            context="{'group_by': 'invoice_date'}"/>
                    <filter string="Status"
                            name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="جاهز للاحاله الي المحاسبه"
                            name="group_is_fully_done"
                            context="{'group_by': 'is_fully_done'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_po_followup" model="ir.actions.act_window">
        <field name="name">PO Follow-up</field>
        <field name="res_model">po.followup</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_po_followup_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start tracking your first PO
            </p>
            <p>
                Add rows directly in the list — same workflow as your Google Sheet.
            </p>
        </field>
    </record>
</odoo>
